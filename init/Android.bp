//
// Galaxy Tab S11 Ultra identity for the Play Store: snapshot the switch
// (persist.sys.tb520fu.spoof_galaxy, "Custom features") at boot so toggling it
// only takes effect after a restart. PropImitationHooks in the framework reads
// sys.tb520fu.spoof_galaxy, never the persist value
// (patches/frameworks_base-0005-tb520fu-galaxy-device-spoof.patch).
//

prebuilt_etc {
    name: "init.tb520fu.spoof.rc",
    src: "init.tb520fu.spoof.rc",
    sub_dir: "init",
}

// Optional Play Integrity spoofing: snapshot the "Custom features" > Integrity
// switches (persist.sys.tb520fu.integrity_*) at boot. The framework hooks and
// the tb520fu-input-custom keybox service read only the sys.* snapshots.
prebuilt_etc {
    name: "init.tb520fu.integrity.rc",
    src: "init.tb520fu.integrity.rc",
    sub_dir: "init",
}
