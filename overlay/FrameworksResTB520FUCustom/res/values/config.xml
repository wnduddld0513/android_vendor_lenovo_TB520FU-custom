<resources>
    <!-- Default wallpaper: Pixel "Feathers" Porcelain live wallpaper
         (FeathersLiveWallpaper.apk). default_wallpaper in the device tree stays
         as the fallback. -->
    <string name="default_wallpaper_component" translatable="false">com.google.pixel.wallpapers23/.liveBirds.porcelain.PorcelainWallpaperService</string>

    <!-- Lenovo Notes as the notes app (stylus button, lock screen notes), as stock -->
    <bool name="config_enableDefaultNotes">true</bool>
    <string name="config_defaultNotes" translatable="false">com.zui.notes</string>
</resources>
