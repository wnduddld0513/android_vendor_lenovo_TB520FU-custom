+     * back so the request cannot fail that way.
+     */
+    private static String pifApi() {
+        String template = Resources.getSystem()
+                .getString(com.android.internal.R.string.config_pifUpdateUrl);
+        String version = SystemProperties.get("net.pixelos.version");
+        if (version == null || version.isEmpty()) {
+            version = "seventeen";
+        }
+        String url = template.replace("{version}", version);
+        if (!url.contains(version)) {
+            url = url.replace("/official_devices/", "/official_devices/" + version + "/");
+        }
