+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.internal.util.custom;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.ServiceManager;
+import android.os.SystemProperties;
+import android.system.keystore2.KeyDescriptor;
+import android.system.keystore2.KeyEntryResponse;
+import android.system.keystore2.KeyMetadata;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * TB520FU: client of the "tb520fu.keybox" service that
+ * tb520fu-input-custom.jar publishes from system_server (the TEESimulator-RS /
+ * TrickyStore port of the customizations repository).
+ *
+ * The framework keystore client runs in every app process, but the keybox
+ * private keys must not be: the service parses the keybox, rewrites the
+ * attestation certificates and returns only the chain. The patched entries are
+ * cached here per app until the service generation changes (a renewed keybox).
+ *
+ * Everything is inert unless sys.tb520fu.integrity_teesim is 1 (the boot
+ * snapshot of the "TEE Simulator" switch in "Custom Tweaks"), and when the
+ * service is missing (a build without the customizations repository) nothing
+ * is called at all.
+ *
+ * @hide
+ */
+public final class KeyboxServiceClient {
+    private static final String TAG = "KeyboxServiceClient";
+    private static final String SERVICE = "tb520fu.keybox";
+    private static final String PROP_ENABLED = "sys.tb520fu.integrity_teesim";
+
+    private static final int TRANSACT_STATUS = 1;
+    private static final int TRANSACT_PATCH = 2;
+
+    private static final int RESULT_NONE = 0;
+    private static final int RESULT_PATCHED = 1;
+
+    private static final long STATUS_TTL_MS = 5000;
+    /** How long a "not targeted" verdict is remembered, to skip binder calls. */
+    private static final long DENY_TTL_MS = 60000;
+
+    private static final Map<String, Cached> sCache = new ConcurrentHashMap<>();
+    private static final Map<Integer, Long> sDenied = new ConcurrentHashMap<>();
+
+    private static volatile boolean sHasKeybox = false;
+    private static volatile long sGeneration = -1;
+    private static volatile long sStatusTime = -1;
+
+    private static final class Cached {
+        final long generation;
+        final KeyEntryResponse response;
+
+        Cached(long generation, KeyEntryResponse response) {
+            this.generation = generation;
+            this.response = response;
+        }
+    }
+
+    private static final class Patched {
+        final byte[] leaf;
+        final List<byte[]> chain;
+
+        Patched(byte[] leaf, List<byte[]> chain) {
+            this.leaf = leaf;
+            this.chain = chain;
+        }
+    }
+
+    private KeyboxServiceClient() {}
+
+    private static IBinder binder() {
+        try {
+            return ServiceManager.getService(SERVICE);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    static boolean isPresent() {
+        return binder() != null;
+    }
+
+    static boolean isEnabled() {
+        return SystemProperties.getBoolean(PROP_ENABLED, false);
+    }
+
+    /** True while a keybox is installed and the service is enabled; cached briefly. */
+    static boolean hasKeybox() {
+        if (!isEnabled()) return false;
+        long now = System.currentTimeMillis();
+        if (sStatusTime >= 0 && now - sStatusTime < STATUS_TTL_MS) {
+            return sHasKeybox;
+        }
+        IBinder binder = binder();
+        if (binder == null) {
+            sHasKeybox = false;
+            sStatusTime = now;
+            return false;
+        }
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            if (!binder.transact(TRANSACT_STATUS, data, reply, 0)) {
+                sHasKeybox = false;
+                return false;
+            }
+            reply.setDataPosition(0);
+            reply.readInt(); // enabled
+            sHasKeybox = reply.readInt() != 0;
+            sGeneration = reply.readLong();
+        } catch (Throwable t) {
+            sHasKeybox = false;
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+        sStatusTime = now;
+        return sHasKeybox;
+    }
+
+    /** Cached patched entry of a previous getKeyEntry call; null when absent/stale. */
+    static KeyEntryResponse cachedEntry(KeyDescriptor descriptor) {
+        if (!isEnabled() || descriptor == null || descriptor.alias == null) return null;
+        String key = key(descriptor);
+        Cached cached = sCache.get(key);
+        if (cached == null) return null;
+        hasKeybox(); // refresh the generation
+        if (cached.generation != sGeneration) {
+            sCache.remove(key);
+            return null;
+        }
+        return cached.response;
+    }
+
+    /**
+     * Replaces the certificates of a real key entry with keybox signed ones.
+     * Returns the same object (with the certificates swapped in) or null when
+     * nothing was patched.
+     */
+    static KeyEntryResponse patch(KeyDescriptor descriptor, KeyEntryResponse response) {
+        if (!isEnabled() || descriptor == null || descriptor.alias == null || response == null
+                || response.metadata == null || response.metadata.certificate == null) {
+            return null;
+        }
+        // The usual case is no keybox at all; hasKeybox() is cached, so this
+        // keeps the binder call out of the certificate chain path entirely.
+        if (!hasKeybox()) return null;
+        Patched patched = patchRemote(descriptor, response.metadata.certificate,
+                splitChain(response.metadata.certificateChain));
+        if (patched == null) return null;
+        response.metadata.certificate = patched.leaf;
+        response.metadata.certificateChain = joinChain(patched.chain);
+        hasKeybox();
+        sCache.put(key(descriptor), new Cached(sGeneration, response));
+        return response;
+    }
+
+    /** Same as {@link #patch} for the metadata a key generation returns. */
+    static KeyMetadata patchMetadata(KeyDescriptor descriptor, KeyMetadata metadata) {
+        if (!isEnabled() || descriptor == null || metadata == null
+                || metadata.certificate == null) {
+            return null;
+        }
+        if (!hasKeybox()) return null;
+        Patched patched = patchRemote(descriptor, metadata.certificate,
+                splitChain(metadata.certificateChain));
+        if (patched == null) return null;
+        metadata.certificate = patched.leaf;
+        metadata.certificateChain = joinChain(patched.chain);
+        return metadata;
+    }
+
+    private static Patched patchRemote(KeyDescriptor descriptor, byte[] leaf, List<byte[]> chain) {
+        IBinder binder = binder();
+        if (binder == null) return null;
+        int uid = Binder.getCallingUid();
+        Long deniedUntil = sDenied.get(uid);
+        if (deniedUntil != null && deniedUntil > System.currentTimeMillis()) return null;
+
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInt(uid);
+            data.writeString(descriptor.alias);
+            data.writeByteArray(leaf);
+            data.writeInt(chain.size());
+            for (byte[] cert : chain) data.writeByteArray(cert);
+
+            if (!binder.transact(TRANSACT_PATCH, data, reply, 0)) return null;
+            reply.setDataPosition(0);
+            if (reply.readInt() != RESULT_PATCHED) {
+                // Not a target: remember the verdict for a while, the chain
+                // read path can be frequent.
+                sDenied.put(uid, System.currentTimeMillis() + DENY_TTL_MS);
+                return null;
+            }
+            byte[] patchedLeaf = reply.createByteArray();
+            int count = reply.readInt();
+            if (patchedLeaf == null || count < 1) return null;
+            List<byte[]> patchedChain = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                byte[] cert = reply.createByteArray();
+                if (cert != null) patchedChain.add(cert);
+            }
+            sDenied.remove(uid);
+            return new Patched(patchedLeaf, patchedChain);
+        } catch (Throwable t) {
+            Log.w(TAG, "attestation patch failed", t);
+            return null;
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+    }
+
+    private static String key(KeyDescriptor descriptor) {
+        return Binder.getCallingUid() + ":" + descriptor.alias;
+    }
+
+    /** The keystore chain is a concatenation of DER certificates. */
+    private static List<byte[]> splitChain(byte[] bytes) {
+        List<byte[]> out = new ArrayList<>();
+        if (bytes == null) return out;
+        int pos = 0;
+        while (pos + 2 <= bytes.length && (bytes[pos] & 0xff) == 0x30) {
+            int lengthByte = bytes[pos + 1] & 0xff;
+            int length;
+            int header;
+            if ((lengthByte & 0x80) == 0) {
+                length = lengthByte;
+                header = 2;
+            } else {
+                int lengthBytes = lengthByte & 0x7f;
+                if (lengthBytes < 1 || lengthBytes > 4 || pos + 2 + lengthBytes > bytes.length) {
+                    break;
+                }
+                length = 0;
+                for (int i = 0; i < lengthBytes; i++) {
+                    length = (length << 8) | (bytes[pos + 2 + i] & 0xff);
+                }
+                header = 2 + lengthBytes;
+            }
+            if (length <= 0 || pos + header + length > bytes.length) break;
+            out.add(Arrays.copyOfRange(bytes, pos, pos + header + length));
+            pos += header + length;
+        }
+        return out;
+    }
+
+    private static byte[] joinChain(List<byte[]> chain) {
+        int total = 0;
+        for (byte[] cert : chain) total += cert.length;
+        byte[] joined = new byte[total];
+        int pos = 0;
+        for (byte[] cert : chain) {
+            System.arraycopy(cert, 0, joined, pos, cert.length);
+            pos += cert.length;
+        }
+        return joined;
+    }
+}
