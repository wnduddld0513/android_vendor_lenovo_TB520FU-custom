//
// Lenovo Notes (ZuiNotes) from the stock global ROM. It is the notes app the
// framework opens from the pen button and the lock screen
// (config_enableDefaultNotes in FrameworksResTB520FUCustom).
//
// The APK is NOT a system app. It is shipped as a plain, unsigned file on the
// read-only system_ext partition and installed into /data as an ordinary,
// removable app once after the first boot by system_server
// (input/src/com/tb520fu/input/custom/NotesPreinstall.java). Keeping it out of
// the app scan means an update cannot be blocked by it and the user can
// uninstall it like any other app.
//
// prebuilt_etc copies the file as-is: no signing, no dexpreopt, no APK
// validation, and no PRODUCT_COPY_FILES (which rejects .apk destinations).
//

prebuilt_etc {
    name: "ZuiNotes",
    src: "ZuiNotes.apk",
    // Without this the module name (ZuiNotes) becomes the installed file name.
    filename: "ZuiNotes.apk",
    sub_dir: "preinstall",
    system_ext_specific: true,
}
