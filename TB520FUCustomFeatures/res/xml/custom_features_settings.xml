<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/app_name">

    <PreferenceCategory
        android:key="custom"
        android:title="@string/app_name">

        <Preference
            android:key="game_perf"
            android:title="@string/game_perf_title"
            android:summary="@string/game_perf_summary"
            android:fragment="com.tb520fu.customfeatures.GamePerfFragment" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="play_store"
        android:title="@string/play_store_category">

        <com.tb520fu.customfeatures.TitleClickSwitchPreference
            android:key="integrity_fix"
            android:title="@string/integrity_fix_title"
            android:summary="@string/integrity_fix_summary"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="spoof_galaxy"
            android:title="@string/spoof_title"
            android:summary="@string/spoof_summary"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
