//
// Game performance enforcement and the key attestation spoofing service,
// loaded into system_server by tb520fu-input. InputCore loads
// /system_ext/framework/tb520fu-input-custom.jar when it is present and calls
// com.tb520fu.input.custom.CustomInput through com.tb520fu.input.InputExtension,
// so a plain build without this repository simply has no game performance
// enforcement and no keybox service.
//

java_library {
    name: "tb520fu-input-custom",

    srcs: ["src/**/*.java"],
    libs: ["//device/lenovo/TB520FU:tb520fu-input"],
    // Certificate forging of the keybox service (X.509 building and ASN.1
    // editing); the classes are also on the system_server boot classpath, the
    // static copy just makes the jar self contained.
    static_libs: ["bouncycastle-repackaged-unbundled"],
    platform_apis: true,
    system_ext_specific: true,
    installable: true,
}
